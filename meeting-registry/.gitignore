# Промежуточные выгрузки сессий и курса: в них встречаются ключи доступа и чужие материалы курса.
00_промежуточные/

# Ключи и локальные настройки — никогда в git.
.env
.env.*
*.key

# Служебное Python и тестов.
__pycache__/
*.pyc
.pytest_cache/

# Записи совещаний не хранятся (правило владельца от 30.09.26).
*.wav
*.mp3
*.m4a
*.mp4
*.ogg

# Временные файлы редакторов.
~$*
*.tmp
